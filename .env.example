# Bootstrap-only config - everything else (AI provider + key, email
# credentials, target countries/roles, rate limiting) is set from the
# dashboard's Settings page after you run `jobpilot serve`, and is stored
# in the local database (data/jobpilot.db, gitignored) instead of here.

DATABASE_URL=sqlite:///./data/jobpilot.db
WEB_HOST=127.0.0.1
WEB_PORT=8000
