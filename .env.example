# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Candidate ---
RESUME_PATH=./data/resume.pdf
TARGET_COUNTRIES=Syria,Turkey,Saudi Arabia
# Comma-separated role keywords used to seed job searches
TARGET_ROLES=Software Engineer,Machine Learning Engineer,Backend Developer

# --- Rate limiting for applications ---
# Send this many applications per batch...
APPLICATION_BATCH_SIZE=10
# ...then wait this many minutes before the next batch.
APPLICATION_BATCH_INTERVAL_MINUTES=10
# Minimum Claude match score (0-100) required before auto-applying
MATCH_THRESHOLD=70

# --- Database ---
DATABASE_URL=sqlite:///./data/jobpilot.db

# --- Email (IMAP/SMTP, any provider) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password
# If false, replies are drafted and stored but not sent automatically.
EMAIL_AUTO_SEND=true

# --- Optional browser-automation connectors ---
# These interact with sites whose Terms of Service prohibit automated
# applications. They are OFF by default - see README "Risks" section
# before enabling either one.
ENABLE_LINKEDIN_CONNECTOR=false
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
ENABLE_INDEED_CONNECTOR=false
INDEED_EMAIL=
INDEED_PASSWORD=
